#class {inixaw} {kill}
#class {inixaw} {open}

#read .tt/AW/start.tin

/* Ticker */
#ticker {unidle} {gl} {600}


/* Aliases */
#var {cspell} {362}
#alias {cc} {cast $cspell}
#alias {qh} {get heal bag;quaff heal}
#alias {qs} {get lotus bag;quaff lotus}
#alias {ep} {wear duffle;enter;wear amulet}

#class {inixaw} {close}
