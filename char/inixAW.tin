#class {inixaw} {kill}
#class {inixaw} {open}

/* Ticker */
#ticker {unidle} {gl} {600}


/* Aliases */
#var {cspell} {362}
#alias {cc} {cast $cspell}
#alias {np} {#map roomflag noglobal on}
#alias {qh} {get heal bag;drink heal}
#alias {qs} {get lotus bag;drink lotus}
#alias {ep} {wear duffle;enter;wear amulet}
#alias {sr} {spellup retry}

#class {inixaw} {close}
