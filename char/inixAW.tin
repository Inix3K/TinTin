#class {inixaw} {kill}
#class {inixaw} {open}

/* Additional Loads */
#read .tt/AW/bootstaff.tin
#read .tt/AW/partroxis.tin
#read .tt/AW/moon.tin

/* Ticker */
#ticker {unidle} {gl} {600}


/* Aliases */
#var {cspell} {362}
#alias {cc} {cast $cspell %0}
#alias {qh} {get heal bag;drink heal}
#alias {qs} {get lotus bag;drink lotus}
#alias {ep} {wear duffle;enter;wear amulet}

#alias {np} {
	#map roomflag noglobal on;
	update_map_info
}
#alias {rn} {#map set {roomname} {$gmcp[room][info][name]}}

#class {inixaw} {close}
