#class {bot} {open}

#var {no_loop} {1}
#var {no_home} {1}
#var {hardmode} {0}
#var {vacuum} {1}

#var {tao[page]} {1}
#act {^You bow deeply in respect to the ancients} {#var tao[flag] 1;#delay {tao} {#if {$tao[flag] == 1} {flipbird all;#var tao[flag] 0}} {0.5}}
#act {^A voice whispers in your mind.  You may proceed.} {continue;bow;#math {tao[page]} {${tao[page]} + 1};#var tao[flag] 0}
#act {room check} {ptell Tao: $tao[book]-$tao[chap]}

#act {^=M= {Being|BigMind|Beauty|Birth|Dark|Death|Dharma|Discord|Earth|Emptiness|Everything|Fullness|Harmony|Heaven|Impermanence|Insubstance|Life|Light|Mind|NoBeing|NoMind|NoSelf|Nothing|NoTime|Others|Peace|Permanence|Self|Silence|Something|Substance|Time|Yang|Yin}} {
	#switch {"%1"} {
		#case {"Bloody zombie"}			{#var mobname zombie};
	};
	_check_mob
}

#class {bot} {close}
