#class {bot} {open}

#var {no_loop} {1}
#var {no_home} {1}
#var {hardmode} {0}
#var {vacuum} {1}

#var mobs 0

#var {botpath} {s;s;sw;sw;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;nw;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;e;ne;n;sw;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;w;n;n;se;se;e;e;e;e;e;e;e;e;e;ne;e;e;e;e;e;e;e;e;e;e;e;e;nw;w;w;w;w;w;w;w;w;w;w;ne;e;e;e;e;e;e;e;e;nw;w;w;w;w;w;w;nw;e;e;e;e;e;e;nw;w;w;w;w;w;w;n;e;e;e;e;e;nw;w;w;w;w;w;s;s;w;n;n;sw;s;s;nw;s;s}

#act {^=M= {}} {
	#math {mobs} {$mobs + 1};
	#showme {MOBS: $mobs};
	#switch {"%1"} {
		#case {"Blue Dolphin"} 		{#var mobname dolphin};
		#case {"Green Chinese Dragon"}	{#var mobname dragon};
		#case {"White Tiger"} 		{#var mobname tiger};
		#case {"Black Tiger"} 		{#var mobname tiger};
		#case {"Purple Butterfly"} 	{#var mobname butterfly};
		#case {"Red Butterfly"} 	{#var mobname butterfly};
		#case {"Sea Serpent"} 		{#var mobname serpent};
		#case {"Golden Phoenix"} 	{#var mobname phoenix};
		#case {"Leaping Rat"} 		{#var mobname rat};
		#case {"Lumbering Ox"} 		{#var mobname ox};
		#case {"Charging Ram"} 		{#var mobname ram};
		#case {"Jade Phoenix"} 		{#var mobname phoenix};
		#case {"Red Rabbit"} 		{#var mobname rabbit};
		#case {"Red Chinese Dragon"} 	{#var mobname dragon};
		#case {"Black Chinese Dragon"} 	{#var mobname dragon};
		#case {"Gold Chinese Dragon"} 	{#var mobname dragon};
		#case {"Winged Horse"} 		{#var mobname {winged horse}}
	};
	#NOP _check_mob
}

#class {bot} {close}
