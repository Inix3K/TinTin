#class {bot} {open}

#var {no_loop} {1}
#var {no_home} {1}
#var {hardmode} {0}
#var {vacuum} {1}

#NOP Alignment of Enemies to kill
#NOP Use: good, evil, or all
#var {alignment} {evil}

#var {botpath} {n;e;s;s;se;se;se;ne;w;nw;e;e;e;ne;w;w;w;w;w;n;e;e;e;e;e;e;e;se;e;nw;e;ne;w;w;w;w;w;w;w;w;w;w;n;e;e;e;e;e;e;e;e;e;nw;w;w;w;w;w;w;w;w;n;e;e;e;e;e;e;e;nw;w;w;w;w;w;ne;e;e;e;nw;w;n;sw;sw;sw;sw;s;s;w;w;n;n;n;nw;n;ne;climb;u;d;d;sw;s;s;s;s;s;w;n;nw;nw;s;w;sw;e;e;e;s;w;w;w;w;sw;e;e;e;e;e;e;e;s;w;w;w;w;w;w;se;e;e;e;e;sw;w;w;se;s;se;n;n;ne;se;n;n;e;n;n;e;s}

#act {^=M= {Impediment}} {
	#var alignment_found none;
	#switch {"%1"} {
		#NOP Evil;
		#case {"Impediment"}		{#var mobname impediment;#var alignment_found evil};
	};
	#if {"$alignment" == "all"} {
		_check_mob
	}; #elseif {"$alignment" == "$alignment_found"} {
		_check_mob
	}
}

#NOP Hunter green
#NOP Handle shadows?

#class {bot} {close}
