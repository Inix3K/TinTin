#class {bot} {open}

#var {no_loop} {1}
#var {no_home} {0}
#var {hardmode} {0}
#var {vacuum} {1}

#var {botpath} {s;s;e;s;s;w;s;n;w;n;n;e;s}

#act {^=M= {Core Guard|Mike McKelly}} {
	#switch {"%1"} {
		#case {"Core Guard"} 	{#var mobname guard};
		#case {"Mike McKelly"}	{#var mobname mike}
	};
	_check_mob
}

#act {#END OF PAT} {killbot;#bell} {1}

#class {bot} {close}
