#class {psicorp} {open}

#var guild psicorp

#NOP  HP: 10183/10183  SP: 1922/1922  PE: 140/140  ST: 1487/1487
#NOP #act {{^(?:> )?\|HP:(\d+)/(\d+) SP:(\d+)/(\d+) PE:(\d+)/(\d+) ST:(\d+)/(\d+) GXP:(\w+)\[(\w+)\%\](?: T:)?([\w\d]+)?}}
#act {^HP: %d/%d  SP: %d/%d  PE: %d/%d  ST: %d/%d} {
	#var {my[hp][current]}	{%1};
	#var {my[hp][max]}	{%2};
	#var {my[sp][current]}	{%3};
	#var {my[sp][max]}	{%4};
	#var {my[gp1][current]}	{%5};
	#var {my[gp1][max]}	{%6};
	#var {my[gp2][current]}	{%7};
	#var {my[gp2][max]}	{%8};
	#NOP #var {my[gxp][tnl]}	{%10};
	#NOP #var {my[gxp][per]}	{%11};
	#NOP #var {ehealth}	{%12};
	update_status
}

#alias update_status {
	#if {$my[hp][current] < ${my[hp][max]}*0.75 && $my[gp1][current] > 20} {
		#send {!body adjustment}
	}; #elseif {$my[sp][current] >= $my[sp][max] && $my[gp1][current] < $my[gp1][max] - $my[sp][max] * .2} {
		#send {!convert}
	}; #elseif {$my[gp2][current] > $my[gp2][max]*.9 && "$jaw" == "off"} {
		#send {!iron jaw}
	}; #elseif {$my[gp2][current] < $my[gp2][max]*.2 && "$jaw" == "on"} {
		#send {!iron jaw off}
	}; #elseif {$my[gp1][current] > $my[gp1][max]*.8 && "$psiwielded" == "off"} {
		#send {!psiwield $weapon}
	}; #elseif {$my[gp1][current] < $my[gp1][max]*.4 && "$psiwielded" == "on"} {
		#send {!unpsiwield $weapon}
	}; #elseif {$my[gp1][current] > $my[gp1][max]*.8 && ${ehealth_len} > 0} {
		#send {!remove shield};
		#send {!dissipating touch};
		#send {!wear shield}
	};
        #if {"$cooler" == "on" || $corpses[cooler] > 0} {
                #format {sb1_cooler} {%+2s} {$corpses[cooler]};
                #var {sb1_cooler} { CL:<139>$sb1_cooler<088>}
        } {
                #var {sb1_cooler} {}
        };
        #if {"$freezer" == "on" || $corpses[freezer] > 0} {
                #format {sb2_freezer} {%+2s} {$corpses[freezer]};
                #var {sb2_freezer} { FZ:<139>$sb2_freezer<088>}
        } {
                #var {sb2_freezer} {}
        };
	#var {my[hp][graph]}	{@graph{$my[hp][current];$my[hp][max]}};
	#var {my[sp][graph]}	{@graph{$my[sp][current];$my[sp][max]}};
	#var {my[gp1][graph]}	{@graph{$my[gp1][current];$my[gp1][max]}};
	#var {my[gp2][graph]}	{@graph{$my[gp2][current];$my[gp2][max]}};
	#var {my[gxp][graph]}	{@graph{$my[gxp][per];100}};
	#var {enemy[graph]}	{@graph{$enemy[hp];100}};
	#format {hp}		{%+4s}	{@colscale{$my[hp][current];$my[hp][max]}};
	#format {hp_max}	{%+4s}	{<128>$my[hp][max]<088>};
	#format {sp}		{%+4s}	{@colscale{$my[sp][current];$my[sp][max]}};
	#format {sp_max}	{%+4s}	{<128>$my[sp][max]<088>};
	#format {gp1}		{%+4s}	{@colscale{$my[gp1][current];$my[gp1][max]}};
	#format {gp1_max}	{%+4s}	{<128>$my[gp1][max]<088>};
	#format {gp2}		{%+4s}	{@colscale{$my[gp2][current];$my[gp2][max]}};
	#format {gp2_max}	{%+4s}	{<128>$my[gp2][max]<088>};
	#format {g2n}		{%+10s}	{$my[gxp][tnl]};
	#format {ehealth}	{%+6s} {@colscale{$enemy[hp];100}};
	#showme {HP:$hp/$hp_max SP:$sp/$sp_max PE:$gp1/$gp1_max  ST:$gp2/$gp2_max  G:$g2n E:$ehealth\%    IC:<139>$corpses[inventory]<088>} {-4};
	#showme {H:$my[hp][graph]   S:$my[sp][graph] PE:$my[gp1][graph] ST:$my[gp2][graph] G:$my[gxp][graph] E:$enemy[graph] CF:<139>$corpses[coffin]<088>$sb2_freezer} {-3};
	#showme {$mip[gline][1]  $mip[gline][2]} {-6}
}

#alias {corpsetrig} {
	#send {!wrap};
	#send {!get coins};
	#send {!get component}
}

#class {psicorp} {close}
