#var gear_invmon[action][2]	wear
#var gear_invmon[action][3]	lost
#var gear_invmon[action][4]	gain
#var gear_invmon[action][5]	get from container
#var gear_invmon[action][6]	put in container
#var gear_invmon[action][7]	consumed
