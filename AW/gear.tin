#class {gear} {kill}
#class {gear} {open}

#NOP ============================================================
#NOP Gear constants and persisted defaults
#NOP ============================================================

#alias {gear_save_vars} {
	#class {var_gear} {write} {.tt/AW/vars/gear.var}
}

#alias {gear_init_defaults} {
	#if {&{gear[container]} == 0} {
		#class {var_gear} {assign} {
			#var {gear[container]} {1860888649}
		}
	};

	#if {&{gear[active_profile]} == 0} {
		#class {var_gear} {assign} {
			#var {gear[active_profile]} {default}
		}
	};

	#if {&{gear_profile[default][mode]} == 0} {
		#class {var_gear} {assign} {
			#var {gear_profile[default][mode]} {itemscore}
		};
		gear_save_vars
	};

	#if {&{gear_profile[default][stat][dr]} == 0} {
		#class {var_gear} {assign} {
			#var {gear_profile[default][stat][str]} {10};
			#var {gear_profile[default][stat][int]} {10};
			#var {gear_profile[default][stat][wis]} {10};
			#var {gear_profile[default][stat][dex]} {10};
			#var {gear_profile[default][stat][con]} {10};
			#var {gear_profile[default][stat][luck]} {10};
			#var {gear_profile[default][stat][hr]} {2};
			#var {gear_profile[default][stat][dr]} {8};
			#var {gear_profile[default][stat][hp]} {0.1};
			#var {gear_profile[default][stat][mana]} {0.1};
			#var {gear_profile[default][stat][moves]} {0.05};
			#var {gear_profile[default][stat][saves]} {-5};
			#var {gear_profile[default][weapon][avgdam]} {1};
			#var {gear_profile[default][resist][acid]} {1};
			#var {gear_profile[default][resist][air]} {1};
			#var {gear_profile[default][resist][cold]} {1};
			#var {gear_profile[default][resist][earth]} {1};
			#var {gear_profile[default][resist][energy]} {1};
			#var {gear_profile[default][resist][fire]} {1};
			#var {gear_profile[default][resist][holy]} {1};
			#var {gear_profile[default][resist][light]} {1};
			#var {gear_profile[default][resist][electric]} {1};
			#var {gear_profile[default][resist][mental]} {1};
			#var {gear_profile[default][resist][negative]} {1};
			#var {gear_profile[default][resist][sonic]} {1};
			#var {gear_profile[default][resist][shadow]} {1};
			#var {gear_profile[default][resist][water]} {1};
			#var {gear_profile[default][resist][magic]} {1};
			#var {gear_profile[default][resist][physical]} {1}
		};
		gear_save_vars
	}
}

/* invmon actions */
