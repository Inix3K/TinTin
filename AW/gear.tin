/* invmon */
#act {^\{invmon\}%1,%2,%3,%4} {
	#var inv[action]	%1;
	#var inv[object]	%2;
	#var inv[container]	%3;
	#var inv[location]	%4;
	#line gag
}

/* eqdata */
#NOP objectid,flags,itemname,level,type,unique,wear-loc,timer
#act {^\{eqdata\}} {
	#var {eqdata} {};
	#act {^%%1,%%2,%%3,%%4,%%5,%%6,%%7,%%8}	{
		#var eqdata[%%7][id]		%%1;
		#var eqdata[%%7][flags]		%%2;
		#var eqdata[%%7][name]		%%3;
		#var eqdata[%%7][level]		%%4;
		#var eqdata[%%7][type]		%%5;
		#var eqdata[%%7][unique]	%%6;
		#var eqdata[%%7][location]	%%7;
		#var eqdata[%%7][timer]		%%8;
		#line gag
	};
	#line gag
}
#act {\{/eqdata\}} {
	#unact {^%%1,%%2,%%3,%%4,%%5,%%6,%%7,%%8};
	#line gag
}

/* Aliases */
#NOP pass the 'level' gear intended to be worn at
#NOP e.g.: 'invsnap 1' for save a snapshot for level 1 gear
#alias eqsnap {
	#format level_len {%L} {%1};
	#if {$level_len > 0} {
		eqdata;
		#delay 2 {#var eqsnap[%1] $eqdata}
	} {
		#echo {eqsnap: Please pass level for snapshop}
	}
}

#NOP Save container id
#var container 1860888649

#NOP pass the 'level' of the snapshot to be worn
#alias gearup {
	#format level_len {%L} {%1};
	#if {$level_len > 0} {
		#var level %1;
		#loop 1 &eqsnap[$level][] cnt {
			#echo {GEARUP: level: $level wear: $cnt id: $eqsnap[$level][$cnt][id]};
			get $eqsnap[$level][$cnt][id] $container;
			wear $eqsnap[$level][$cnt][id]
			
		}
	} {
		#echo {gearup: Please pass level for gearup}
	}
	
}

#class {gear} {close}
