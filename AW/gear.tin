#var gear_invmon[action][9]	put in vault
#var gear_invmon[action][10]	get from vault
#var gear_invmon[action][11]	put on keyring
#var gear_invmon[action][12]	get from keyring

/* wear-loc (wearable) */
#var gear_loc[0]	light
#var gear_loc[1]	head
#var gear_loc[2]	eyes
#var gear_loc[3]	lear
#var gear_loc[4]	rear
#var gear_loc[5]	neck1
#var gear_loc[6]	neck2
#var gear_loc[7]	back
#var gear_loc[8]	medal1
#var gear_loc[9]	medal2
#var gear_loc[10]	medal3
#var gear_loc[11]	medal4
#var gear_loc[12]	torso
#var gear_loc[13]	body
#var gear_loc[14]	waist
#var gear_loc[15]	arms
#var gear_loc[16]	lwrist
#var gear_loc[17]	rwrist
#var gear_loc[18]	hands
#var gear_loc[19]	lfinger
#var gear_loc[20]	rfinger
#var gear_loc[21]	legs
#var gear_loc[22]	feet
#var gear_loc[23]	shield
#var gear_loc[24]	wielded
#var gear_loc[25]	second
#var gear_loc[26]	hold
#var gear_loc[27]	float
#var gear_loc[28]	undefined
#var gear_loc[29]	undefined
#var gear_loc[30]	above
