#class {chat} {kill}
#class {chat} {open}

#read .tt/AW/vars/AWchat.var

#var chat[page] 1
#var chat[max] 100

#ALIAS {show_chat} {
	#if {"$draw[chat]" != "on"} {#return};

	#math chat[start]	{$chat[rows] * $chat[page]};
	#math chat[end]		{$chat[rows] * $chat[page] - $chat[rows] + 1};
	#draw tile $chat[row][start] $chat[col][start] $chat[row][end] $chat[col][end] $chat[log][-$chat[start]..-$chat[end]]
}

#ALIAS {update_chat} {
	#if {&chat[log][] > $chat[max]} {
		#list chat[log] del 1
	};
	#format {timestamp} {%t} {<108>[<268>%H<108>:<268>%M<108>]<088> };
	#list chat[log] ins -1 {${timestamp}%0};

	#class {chat} {write} {.tt/AW/vars/${mud}chat.var};
	show_chat
}

#ALIAS {chatup} {
        #if {"$chat[scroll]" == "page"} {
                #if {$chat[rows]*{$chat[page]+1} <= $chat[max] &&
                     $chat[rows]*{$chat[page]+1} <= &chat[log][]} {
                        #math chat[page] {$chat[page] + 1};
                        #math chat[offset] {$chat[page] * $chat[rows] - $chat[rows]};
                        show_chat
                }
        }; #elseif {"$chat[scroll]" == "line"} {
                #if {$chat[offset] <= $chat[max] &&
                     $chat[offset] <= &chat[log][]} {
                        #math chat[offset] {$chat[offset] + 1};
                        show_chat
                }
        }
}
#ALIAS {chatdown} {
        #if {"$chat[scroll]" == "page"} {
                #if {$chat[page] > 1} {
                        #math chat[page] {$chat[page] - 1};
                        #math chat[offset] {$chat[page] * $chat[rows] - $chat[rows]};
                        show_chat
                }
        }; #elseif {"$chat[scroll]" == "line"} {
                #if {$chat[offset] > 0} {
                        #math chat[offset] {$chat[offset] - 1};
                        show_chat
                }
        }
}
#ALIAS {chatend} {
        #var chat[page] 1;
        #var chat[offset] 0;
        show_chat
}

#NOP Misc monitors
#act {^You feel as if you are being watched.$} {
	update_chat %0
}
#act {^You sense that %1 is scrying you.%} {
	update_chat %0
}

#class {chat} {close}
