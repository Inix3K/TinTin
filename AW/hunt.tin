#class {hunt} {kill}
#class {hunt} {open}

/* Hunting */
#var {hunt_mode} {off}
#var {hunt_cnt} {0}
#var {hunt_tgt} {}
#var {hunt_dir} {}

#alias {hc} {
	#if {"%1" == ""} {
		#echo {<218>SYNTAX<088>: <118>hc <target>};
		#return
	};

	#var {hunt_mode} {check};
        #var {hunt_cnt} {1};
        #var {hunt_tgt} {%1};
	#var {hunt_dir} {};

        hunt $hunt_tgt
}

#alias {ht} {
	#if {"%1" == ""} {
		#echo {<218>SYNTAX<088: <118>ht <target>};
		#return
	};
	#var {hunt_mode} {travel};
	#var {hunt_cnt} {0};
        #var {hunt_tgt} {%1};
	#var {hunt_dir} {};

        hunt $hunt_tgt
}

#alias {hs} {
	#var {hunt_mode} {off};
	#var {hunt_cnt} {0};
	#var {hunt_tgt} {};
	#var {hunt_dir} {};

	#echo {<218>HUNT<088>: <118>Hunting Stopped}
}

#act {You have no idea what you're doing, but maybe %1 is %2?} {do_hunt_check %2 %1}
#act {You are confident that %1 passed through here, heading %2.} {do_hunt_check %2 %1}
#act {You are certain that %1 is %2 from here.} {do_hunt_check %2 %1}

#alias {do_hunt_check} {
        #var hunt_dir %1;

	#switch {"$hunt_mode"} {
		#case {"check"} {
                	#math {hunt_cnt} {$hunt_cnt + 1};
	                hunt $hunt_cnt\.$hunt_tgt
	        };

		#case {"travel"} {
	                #send $hunt_dir;
        	        hunt $hunt_tgt
        	}
	}
}

#act {You seem unable to hunt that target for some reason.} {
	#switch {"$hunt_mode"} {
		#case {"check"} {
	                #var {hunt_mode} {off};
	                #echo {<218>TARGET ID<088>: <118>$hunt_cnt};
	                wf $hunt_cnt\.$hunt_tgt
		};

		#case {"travel"} {
			#var {hunt_mode} {off};
			#echo {<218>HUNT<088>: <118>Unable to continue toward $hunt_tgt}
		}
        }
}

#act {is here!$} {
	#var {hunt_mode} {off}
}

#class {hunt} {close}
