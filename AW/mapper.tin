#class {awmap} {kill}
#class {awmap} {open}
/* Required */
#NOP gmcp.tin
#NOP terrain.tin


#read .tt/AW/terrain.tin

#map read .tt/map/AW.map
#map goto 1

/* Data Grab Triggers */
#var longcap off

#act {~\{rdesc\}} {
	#map get roomdesc {roomdesc};
	#if {"$roomdesc" == ""} {
		#var longcap on;
		#unvar long;
		#act {%%1} {
			#var long {${long}%%1 }
		} {2}
	}
}
#sub {\{rdesc\}} {}

#act {\{/rdesc\}} {
	#if {"$longcap" == "on"} {
		#var longcap off;
		#unact {%%1};
		#map set roomdesc {$long}
	}
} {1}
#sub {\{/rdesc\}} {}

#act {You are in area : %1} {
	#var area %1;
	#if {"$areas[$gmcp[room][info][zone]]" == ""} {
		#var {areas[$gmcp[room][info][zone]][name]} {$area};
		#class {var_areas} {write} {.tt/AW/vars/areas.var}
	}
}

/* Map Room Events */
#event {MAP ENTER ROOM 11910} {enter hole}

/* Where Find */
#NOP First attempt at snd stuff...not used now, just use snd.tin
#alias {wf} {
	#map get {roomarea} {area};
	#act {{([\D]{30}) ([\D]+)}} {
		#unact {{([\D]{30}) ([\D]+)}};
		#format {findloc} {%%p} {%%3};
		#if {"$findloc" != ""} {
			#map find {roomname} {%*$findloc%*} {roomarea} {$area};
			#map list {roomname} {%*$findloc%*} {roomarea} {$area};
		}
	};
	where %0;
}

#alias {wfr} {
	wf %0;
	#delay 0.5 {#path run};
}

#alias {pr} {#path run}

/* Aliases */
#NOP Count the # of rooms mapped
#alias {area_mapped %1} {
	#unvar area_mapped;
	#map list {} {} {} {%1} {variable} {area_mapped};
	#showme {$area_mapped[] rooms mapped. };
}

#alias {go} {
        #map find {roomnote} %0;
        #path run
}

#alias {goa} {
	#map find {roomarea} {%0%*};
	#path run
}

#alias {goar} {
	#map find {roomarea} %0;
	#path run
}


#alias {mapgo} {#map goto {roomnote} {%0}}

#alias {mf} {#map list {roomname} {%i%*%0%*}}
#alias {mr} {#map run}

#alias {mapsearch} {
	#show <129>Name matches:<088>;
	#map list {%i%*%0%*};
	#show \n;
	#show <129>Note matches:<088>;
	#map list {} {} {} {} {%i%*%0%*};
}

#alias {mapsave} {#map write .tt/map/AW.map}

#alias {door} {
	#map exit {%1} command {open %1;%1}
}

#alias {he} {#map exitflag {%1} hide}

/* AW Map Capture */
#act {^<MAPSTART>$} {
	#list minimap clear;
	#act {~%%1} {
		#list minimap ins -1 {%%1};
		#line gag
	};
	#line gag
}

#act {^<MAPEND>$} {
	#unact {~%%1};
	draw_minimap;
	#line gag
} {1}

#class {awmap} {close}
