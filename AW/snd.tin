#act {You still have to kill \* %1 \(%2\)} {
        #map list {roomname} {%2} {variable} {maplist};
	#foreach {$maplist} {maproom} {
		#if {$maproom > 0} {
			#map get {roomarea} {maparea} {$maproom};
			#echo {Room: $maproom Area: $maparea}
		}
	}
}

#act {You still have to kill %d \* %2 \(%3\)} {
	#map list {roomname} {%3} {variable} {maplist};
	#foreach {$maplist} {maproom} {
		#if {$maproom > 0} {
			#map get {roomarea} {maparea} {$maproom};
			#echo {Room: $maproom Area: $maparea}
		}
	}
}

#NOP Map list enhancement
#act {vnum: %d dist} {
	#map get {roomarea} {maparea} {%1};
	#echo {AREA: $maparea}
}

#NOP Kill at least (global quest)

#act {^Alex, the Taskmaster tells you 'Good luck in your campaign!'$} {
	cpi
}

#act {^Find and kill %d \* %2 \(%3\)} {
	#var cp[target]		%2;
	#var cp[location]	%3;
	
	#NOP Format target name;
	#var cp[target] @mobformat{$cp[target]};

	#var {campaign[$cp[target]]} {$cp[location]}
}

#NOP Old Formatting
#alias oldcpformatting {
	#NOP format target for easier use with where;
	#format cp[target] {%l} {$cp[target]};

	#NOP Check target for a leading article 'the';
	#format cp[article] {%.4s} {$cp[target]};

	#NOP Remove article 'the' if detected;
	#if {"$cp[article]" == "the "} {
		#format cp[len]		{%L} $cp[target];
		#format cp[target]	{%r} $cp[target];
		#math	cp[len]		{$cp[len] - 4};
		#format cp[target]	{%.${cp[len]}s} $cp[target];
		#format cp[target]	{%r} $cp[target];
	};

	#NOP Check target for a leading artcle 'an';
	#format cp[article] {%.3s} {$cp[article]};

	#NOP Remove article 'an' if detected;
	#if {"$cp[article]" == "an "} {
		#format cp[len] 	{%L} $cp[target];
		#format cp[target]	{%r} $cp[target];
		#math	cp[len]		{$cp[len] - 3};
		#format cp[target]	{%.${cp[len]}s} $cp[target];
		#format cp[target]	{%r} $cp[target];
	};

	#NOP Check target for a leading artcle 'a';
	#format cp[article] {%.2s} {$cp[article]};

	#NOP Remove article 'a' if detected;
	#if {"$cp[article]" == "a "} {
		#format cp[len] 	{%L} $cp[target];
		#format cp[target]	{%r} $cp[target];
		#math	cp[len]		{$cp[len] - 2};
		#format cp[target]	{%.${cp[len]}s} $cp[target];
		#format cp[target]	{%r} $cp[target];
	};

	#NOP Remove articles and punctuation internal to target name;
	#replace {cp[target]} {some }	{};
	#replace {cp[target]} { from }	{ };
	#replace {cp[target]} { and }	{ };
	#replace {cp[target]} { the }	{ };
	#replace {cp[target]} { sea }	{ };
	#replace {cp[target]} { an }	{ };
	#replace {cp[target]} { a }	{ };
	#replace {cp[target]} { of }	{ };
	#replace {cp[target]} { to }	{ };
	#replace {cp[target]} {-}	{ };
	#replace {cp[target]} {,}	{};
	#replace {cp[target]} {'s}	{};
	#replace {cp[target]} {'}	{};
	#replace {cp[target]} {.}	{};
}

#act {^Congratulations, that was one of your CAMPAIGN mobs!} {
	#math cp[index] {$cp[index] + 1};
	cpgocheck
}

#alias cpgocheck {
	#if {$gmcp[char][status][state] == 3} {
		cpgo;
		#untick CampaignGo
	} {
		#tick {CampaignGo} {cpgocheck} {1}
	}
}

#alias cpxcheck {
	#if {$gmcp[room][info][num] == $vnum} {
		#delay {DoCPX} {cpx} {0.5};
		#untick CampaignCPX
	} {
		#tick {CampaignCPX} {cpxcheck} {1}
	}
}

#act {^A Grumpy Old General tells you 'Good luck in your campaign!'} {cpi}

#act {^CONGRATULATIONS! You have completed your campaign.} {
	#untick CampaignGo;
	#unvar campaign;
	#unvar cp
}

#alias cpi {
	#unvar campaign;
	#var cp[index] 1;
	cp info
}

#alias cpii {
	#math cp[index] {$cp[index] + 1}
}

#alias cpgo {
	#NOP Get campaign target;
	#var cp[target]		*campaign[+$cp[index]];


	#NOP Find short name for location;
	#var cp[location]	$campaign[$cp[target]];
	#var cp[short] @areakey{$cp[location]};

	#if {"$cp[short]" != ""} {
		#NOP Area Mode;
		#map go {roomarea} {$cp[short]};
		#map get {roomvnum} {vnum};
		#map go $gmcp[room][info][num];
		cpxcheck;
		#NOP #event {MAP ENTER ROOM $vnum};
		#NOP 	#unevent {MAP ENTER ROOM $vnum};
		#NOP	#delay 1 cpxcheck;
		#NOP {};
		#delay 0 goar $cp[short]
	} {
		#NOP Room Mode;
		sndroom {$cp[target]} {$cp[location]}
	};
}

#alias cpx {
	snd $cp[target]
}

#alias cpk {
	k $cp[target]
}

#alias cphc {
	hc $cp[target]
}

#alias snd {
	#var sndmob %0;
	#var snd on;

	#map get {roomarea} {area};

	#act {{(\D{30}) (\D+)}} {
		#unact {{(\D{30}) (\D+)}};
		#var temp {%%3};
		#format {findloc} {%%p} {%%3};
		#echo {$findloc};

		snd_find_rooms {$findloc} {$area};
		#if {&rooms[] > 0} {
			sndr
		} {
			#echo {<128>SND<099>: No mapped rooms found for $findloc in $area}
		}
	};

	where $sndmob;
}

#alias snd_add_room {
	#regex {%1} {\.000} {#nop} {#list {rooms} add {%1}}
}

#alias snd_find_rooms {
	#unvar rooms;
	#unvar roomlist;
	#list rooms cre;
	#var snd_find_loc %1;
	#var snd_find_scope %2;
	#if {"$snd_find_scope" == ""} {
		#map get {roomarea} {snd_find_scope}
	};
	#if {"$snd_find_scope" == "level"} {
		#map list {roomname} {%*$snd_find_loc%*} {variable} {roomlist};
		#foreach {$roomlist} {room} {
			#if {$room > 0} {
				#map get {roomarea} {snd_find_area} {$room};
				#if {@areainlevel{$snd_find_area}} {
					snd_add_room {$room}
				}
			}
		}
	} {
		#map list {roomname} {%*$snd_find_loc%*} {roomarea} {$snd_find_scope} {variable} {roomlist};
		#foreach {$roomlist} {room} {
			#if {$room > 0} {
				snd_add_room {$room}
			}
		}
	}
}

#alias sndroom {
	#var sndmob %1;
	#var snd on;
	#format {sndroom_loc} {%p} {%2};
	snd_find_rooms {$sndroom_loc} {level};
	#if {&rooms[] > 0} {
		sndr
	} {
		#echo {<128>SND<099>: No level-range mapped rooms found for $sndroom_loc}
	}
}

#alias sndr {
	#map run $rooms[1];
	#list rooms del 1;

	#var sndtouch 1;
	study $sndmob;
}

#act {There is no one here by that name.} {
	#if {$sndtouch && &rooms[] > 0} {
		#delay 0 sndr
	};
	#unvar sndtouch
}

#alias snds {
	#class {snd} {kill};
	#delay 1 #read .tt/AW/snd.tin
}

#act {Not while you are fighting!} {
	#if {"$snd" == "on"} {
		snds
	}
}


#class {snd} {close}
