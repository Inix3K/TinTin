#class {snd} {open}

/* Quests */
#NOP Old method
#act {^%1 can be found in the vicinity of %2 which} {
	#var quest[mob] %1;
	#var quest[room] %2
}

#NOP Old method
#act {^is in the general area of %1.} {
	#var quest[area] %1;
	#var quest[zone] @areakey{$quest[area]};
	#if {"$quest[zone]" == ""} {
		#echo {<128>QUEST<099>: Unknown area $quest[area]};
		#return
	};
	#map find {roomarea} {$quest[zone]} {roomname} {%*$quest[room]%*};
	#delay 0 #map list {roomarea} {$quest[zone]} {roomname} {$quest[room]}
}

#NOP Use this alias since GMCP sets it all up
#NOP qgo - Quest Go
#alias qgo {
	#var quest[mob] @mobformat{$gmcp[comm][quest][targ]};
	#var quest[zone] @areakey{$gmcp[comm][quest][area]};
	#if {"$quest[zone]" == ""} {
		#echo {<128>QUEST<099>: Unknown area $gmcp[comm][quest][area]};
		#return
	};
        #map find {roomarea} {$quest[zone]} {roomname} {$gmcp[comm][quest][room]};
	#path run
}

#NOP qx - Quest Search
#alias qx {
	snd $quest[mob]
}

#NOP qk - Quest Kill
#alias qk {
	k $quest[mob]
}


/* Campaigns */

